# API Key 环境变量模板
# 复制本文件为 .env 并填入真实值，.env 已被 .gitignore 排除不会入 git

# Semantic Scholar API Key（可选，提高速率限制）
# 申请: https://www.semanticscholar.org/product/api#api-key
SEMANTIC_SCHOLAR_API_KEY=

# IEEE Xplore API Key（使用 IEEE 数据源时必填）
# 申请: https://developer.ieee.org/
IEEE_API_KEY=

# OpenAlex 邮箱（可选，提高响应速度）
# 填入任意有效邮箱即可
OPENALEX_EMAIL=

# CORE API Key（使用 CORE 数据源时必填，免费注册）
# 申请: https://core.ac.uk/services/apis/
CORE_API_KEY=

# 百度翻译（使用 baidu 引擎时必填）
# 申请: https://fanyi-api.baidu.com/
BAIDU_TRANSLATE_APP_ID=
BAIDU_TRANSLATE_APP_KEY=

# LLM 深度分析（DeepSeek / OpenAI 兼容格式）
# 申请: https://platform.deepseek.com/ 或 https://platform.openai.com/
LLM_API_KEY=
